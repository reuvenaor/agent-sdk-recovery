{
  "name": "agent-sdk-recovery",
  "version": "0.1.1",
  "type": "module",
  "description": "Recover a structured result from an agent session: its structured_output, then the StructuredOutput inputs the CLI rejected, then the JSON in its result text and its assistant texts.",
  "keywords": [
    "claude",
    "claude-agent-sdk",
    "claude-code",
    "anthropic",
    "agent",
    "ai-agent",
    "structured-output",
    "json",
    "json-repair",
    "recovery",
    "standard-schema",
    "zod",
    "llm"
  ],
  "author": {
    "name": "Reuven Naor",
    "email": "info@reuvenaor.com",
    "url": "https://github.com/reuvenaor"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reuvenaor/agent-sdk-recovery.git"
  },
  "homepage": "https://github.com/reuvenaor/agent-sdk-recovery#readme",
  "bugs": {
    "url": "https://github.com/reuvenaor/agent-sdk-recovery/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx test/check-recovery.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check:package": "tsx scripts/check-package.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:package",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "jsonrepair": "^3.14.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.24",
    "tsx": "^4.22.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "zod": "^4.4.3"
  }
}
